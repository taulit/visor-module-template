{
  "name": "visor-module-template",
  "version": "1.0.0",
  "description": "Template for modules of Visor, the notch for GNOME Shell",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "pack:zip": "bash scripts/pack.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "pot": "bash scripts/update-pot.sh",
    "sync:sdk": "bash scripts/sync-sdk.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@girs/gjs": "^4.1.0",
    "@girs/gnome-shell": "50.0.4",
    "@girs/soup-3.0": "4.9.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
